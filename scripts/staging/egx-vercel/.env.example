# Meza — environment template.
# Copy to .env and fill real values:   cp .env.example .env
# Never commit the real .env.

# --- Required ---
# SQLite file path. Docker Compose overrides this to file:/app/db/custom.db.
DATABASE_URL="file:/home/YOUR_USER/meza/db/custom.db"
# Admin area passcode (login page of /admin) — use a long random string.
ADMIN_PASSCODE="CHANGE-ME-long-random-passcode"

# --- Required for scheduled jobs (cron hitting /api/v1/cron/*) ---
# Sent as the x-cron-secret header (or Bearer). Generate: openssl rand -hex 32
CRON_SECRET="CHANGE-ME-openssl-rand-hex-32"

# --- Public site URL (SEO, sitemap, OG images) ---
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# --- Optional ---
# Demo/temp edit mode for the review UI ("1" enables) — keep OFF in production.
NEXT_PUBLIC_TEMP_EDIT_MODE=""
# Comma-separated proxy IPs in front of the app so rate limiting trusts
# x-forwarded-for only from them (e.g. "10.0.0.1,10.0.0.2").
TRUSTED_PROXIES=""

# --- OAuth social sign-in (optional; provider UI hidden when unset) ---
# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: https://YOUR_DOMAIN/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook developers → App → Facebook Login.
# Valid OAuth Redirect URI: https://YOUR_DOMAIN/api/v1/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# HMAC key signing OAuth state cookies (CSRF). Generate: openssl rand -hex 32
# Falls back to CRON_SECRET if unset.
OAUTH_STATE_SECRET=""
# Public base URL behind proxies that mangle the host header (defaults to request origin).
OAUTH_REDIRECT_BASE=""

# --- SQLite concurrency tuning (recommended under load) ---
# connection_limit: Prisma pool size (SQLite writes serialize; keep small).
# busy_timeout: ms a query waits for a locked DB before failing.
DATABASE_URL="file:./db/custom.db?connection_limit=8&busy_timeout=15000"

# --- Outbound email (password-reset / verification delivery) ---
# Wire an SMTP/Resend provider and call it from
# src/app/api/v1/auth/forgot-password/route.ts — tokens are stored in
# PasswordResetToken today but NO email is delivered without this.
EMAIL_PROVIDER=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
