# Meza — environment template.
# Copy to .env and fill real values:   cp .env.example .env
# Never commit the real .env.

# --- Required ---
# Database. TWO modes (see src/lib/db.ts):
#   1. Local/self-hosted SQLite file (Turso vars unset):
#        DATABASE_URL="file:./db/custom.db?connection_limit=8&busy_timeout=15000"
#   2. Turso cloud database (Vercel/production — set TURSO_* below):
#        DATABASE_URL="file:./db/unused.db"   (dummy — runtime uses the adapter)
DATABASE_URL="file:./db/custom.db?connection_limit=8&busy_timeout=15000"
# Admin area passcode (login page of /admin) — use a long random string.
ADMIN_PASSCODE="CHANGE-ME-long-random-passcode"

# --- Required for scheduled jobs (external cron hitting /api/v1/cron/maintenance) ---
# Sent as the x-cron-secret header (or Bearer). Generate: openssl rand -hex 32
CRON_SECRET="CHANGE-ME-openssl-rand-hex-32"

# --- Public site URL (SEO, sitemap, OG images, password-reset links) ---
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# --- Turso cloud database (the Vercel production path; empty = local SQLite) ---
# Create at https://turso.tech → free plan → copy the libsql:// URL + token.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# --- AI provider (OpenAI-compatible API; empty = sandbox z-ai SDK) ---
# Works with Google Gemini's OpenAI-compatible endpoint (free tier available),
# GLM/Zhipu (https://open.bigmodel.cn/api/paas/v4/), OpenRouter, etc.
# AI_BASE_URL default: https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL default:    gemini-2.5-flash   (GLM alternative: glm-4-flash)
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""

# --- Optional ---
# Demo/temp edit mode for the review UI ("1" enables) — keep OFF in production.
NEXT_PUBLIC_TEMP_EDIT_MODE=""
# "*" trusts the platform edge proxy's x-forwarded-for (correct for Vercel);
# self-hosted behind your own nginx: list its IPs instead.
TRUSTED_PROXIES="*"

# --- Outbound email (password reset + welcome mail) — Gmail SMTP app password ---
# MAIL_PROVIDER: "smtp" (Gmail) or "resend" (HTTP API). Empty = no mail; the
# forgot-password flow then logs the raw token to the audit log (manual delivery).
MAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
RESEND_API_KEY=""
MAIL_FROM="Meza <your-gmail@gmail.com>"

# --- OAuth social sign-in (optional; provider UI hidden when unset) ---
# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: https://YOUR_DOMAIN/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook developers → App → Facebook Login.
# Valid OAuth Redirect URI: https://YOUR_DOMAIN/api/v1/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# HMAC key signing OAuth state cookies (CSRF). Generate: openssl rand -hex 32
# Falls back to CRON_SECRET if unset.
OAUTH_STATE_SECRET=""
# Public base URL behind proxies that mangle the host header (defaults to request origin).
OAUTH_REDIRECT_BASE=""
